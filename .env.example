APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_ISSUER=qrevent-api
JWT_AUDIENCE=qrevent-mobile
DATABASE_URL=sqlite:///./qrevent.db
TEST_DATABASE_URL=postgresql+psycopg://<test-user>:<password>@127.0.0.1:5432/qrevent_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
CORS_ORIGINS=http://localhost:8081,http://localhost:8082
TRUSTED_HOSTS=127.0.0.1,localhost
ALLOW_PUBLIC_HOST_REGISTRATION=false
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
MAX_REQUEST_BYTES=10485760
MAX_CSV_BYTES=5242880
MAX_CSV_ROWS=5000
GOOGLE_CLIENT_IDS=
GOOGLE_ALLOWED_DOMAIN=
BOOTSTRAP_ADMIN_NAME=School Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-bootstrap-password
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
NOTIFY_RATE_LIMIT_MINUTES=5
